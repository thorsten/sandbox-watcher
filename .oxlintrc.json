{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["fixtures/**", "src-tauri/**", "dist/**"],
  "settings": {
    "react": {
      "version": "19"
    }
  }
}
