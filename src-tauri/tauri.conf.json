{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sandbox Watcher",
  "version": "0.2.0",
  "identifier": "info.rinne.sandbox-watcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sandbox Watcher",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Thorsten Rinne",
    "copyright": "\u00a9 2026 Thorsten Rinne",
    "license": "MIT",
    "homepage": "https://thorsten.github.io/sandbox-watcher/",
    "category": "DeveloperTool",
    "shortDescription": "Overview of your running MaibornWolff Sandbox containers",
    "longDescription": "Shows which sandbox containers are running, which agents work inside them, what they reach on the network, what they consume, and lets you stop them or open the project."
  }
}
